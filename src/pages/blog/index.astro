---
import PublishingLayout from '../../layouts/PublishingLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort((a, b) =>
  (b.data.pubDate?.getTime() ?? 0) - (a.data.pubDate?.getTime() ?? 0)
);
const formatDate = (date?: Date) => date?.toLocaleDateString('en-US', {year:'numeric',month:'long',day:'numeric'});
---
<PublishingLayout title="Blog Posts" description="Articles published using Pages CMS and rendered by Astro.">
  <div class="wrap">
    <span class="eyebrow">Content collection / Blog</span>
    <h1>Blog posts.</h1>
    <p class="lede">These entries are pulled from Markdown files managed through Pages CMS.</p>
    {posts.length === 0 ? (
      <p class="muted">No posts yet. Create your first post in Pages CMS, then pull the changes.</p>
    ) : (
      <div class="post-grid">
        {posts.map((post) => (
          <a class="post-card" href={`/blog/${post.id}/`}>
            {post.data.featuredImage && <img src={post.data.featuredImage} alt="" loading="lazy" />}
            <div class="post-card__inner">
              {post.data.pubDate && <time class="date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>}
              <h2>{post.data.title}</h2>
              {post.data.description && <p>{post.data.description}</p>}
              <span class="date">READ ARTICLE →</span>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</PublishingLayout>
