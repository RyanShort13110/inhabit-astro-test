---
interface Props { title: string; description?: string; }
const { title, description = 'A demonstration of Astro + Pages CMS publishing.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Astro Publishing Demo</title>
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href="/publishing-demo/">ASTRO <span>×</span> PAGES CMS</a>
      <nav aria-label="Primary navigation">
        <a href="/publishing-demo/">Demo Home</a>
        <a href="/blog/">Blog</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="footer">Developer-built pages · Marketing-managed content</footer>
  </body>
</html>
<style is:global>
  :root { font-family: system-ui, -apple-system, Segoe UI, sans-serif; color-scheme: dark; background: #080d16; color: #ecf3ff; }
  * { box-sizing: border-box; }
  body { margin: 0; line-height: 1.65; }
  a { color: inherit; }
  a:focus-visible { outline: 2px solid #53d9f8; outline-offset: 4px; }
  .site-header { max-width: 1100px; margin: auto; padding: 24px 20px; display: flex; justify-content: space-between; align-items: center; gap: 20px; border-bottom: 1px solid #27374b; }
  .site-header nav { display: flex; gap: 20px; }
  .site-header nav a { font-size: .9rem; text-decoration: none; color: #b6c9df; }
  .site-header nav a:hover { color: #53d9f8; }
  .logo { font-weight: 800; letter-spacing: .07em; text-decoration: none; font-size: .85rem; }
  .logo span { color: #53d9f8; }
  .wrap { max-width: 1040px; padding: 64px 20px 90px; margin: auto; }
  .eyebrow { color: #53d9f8; text-transform: uppercase; font-size: .72rem; font-weight: 800; letter-spacing: .18em; }
  h1 { line-height: 1.1; letter-spacing: -.045em; font-size: clamp(2.5rem, 7vw, 5.3rem); margin: 14px 0 24px; }
  h2 { line-height: 1.2; }
  .lede { color: #a8b8cf; max-width: 650px; font-size: 1.1rem; }
  .post-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 275px),1fr)); gap: 20px; margin-top: 44px; }
  .post-card { display: block; overflow: hidden; border: 1px solid #2d3e55; border-radius: 16px; background: #101a29; text-decoration: none; transition: transform .2s ease, border-color .2s ease; }
  .post-card:hover { transform: translateY(-4px); border-color: #53d9f8; }
  .post-card img { width:100%; aspect-ratio: 16 / 9; object-fit: cover; display: block; }
  .post-card__inner { padding: 24px; }
  .post-card h2 { margin: 8px 0 12px; font-size: 1.4rem; }
  .post-card p, .muted { color: #a8b8cf; }
  .date { font-size: .75rem; color: #53d9f8; font-weight: 700; letter-spacing: .06em; }
  .article { max-width: 790px; }
  .article header { margin-bottom: 36px; }
  .article-cover { width: 100%; border-radius: 16px; aspect-ratio: 16 / 9; object-fit: cover; margin-bottom: 32px; }
  .article-body { color: #d7e2f1; font-size: 1.08rem; overflow-wrap: anywhere; }
  .article-body p, .article-body ul, .article-body ol { margin: 1em 0 1.3em; }
  .article-body h2, .article-body h3 { margin: 1.8em 0 .6em; }
  .article-body img { max-width:100%; height: auto; border-radius: 12px; }
  .article-body a { color: #69d9ff; }
  .article-body pre { overflow-x:auto; background:#16233a; padding: 18px; border-radius: 10px; }
  .back { display: inline-block; margin-bottom: 28px; color: #9bdcf4; }
  .button { display: inline-block; background: #4cd5f4; color:#09111c; border-radius: 999px; padding: 11px 20px; text-decoration:none; font-weight:750; }
  .footer { border-top: 1px solid #27374b; padding: 27px 20px; color: #93aac1; text-align:center; font-size:.8rem; }
  @media (prefers-reduced-motion: reduce) { .post-card { transition: none; } .post-card:hover { transform:none; } }
  @media (max-width: 560px) { .site-header { align-items: flex-start; flex-direction: column; } .wrap { padding-top: 40px; } }
</style>
